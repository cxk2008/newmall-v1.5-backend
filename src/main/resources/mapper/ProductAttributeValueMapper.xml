<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itye.mall.mapper.ProductAttributeValueMapper">
    <sql id="columns">id, product_id, attribute_id, value, created_at</sql>
    <select id="selectById" resultType="com.itye.mall.entity.ProductAttributeValue">SELECT <include refid="columns" /> FROM product_attribute_values WHERE id = #{id}</select>
    <select id="selectAll" resultType="com.itye.mall.entity.ProductAttributeValue">SELECT <include refid="columns" /> FROM product_attribute_values</select>
    <select id="selectByProductId" resultType="com.itye.mall.entity.ProductAttributeValue">
        SELECT <include refid="columns" /> FROM product_attribute_values WHERE product_id = #{productId} ORDER BY id ASC
    </select>
    <insert id="insert" parameterType="com.itye.mall.entity.ProductAttributeValue" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product_attribute_values
        <trim prefix="(" suffix=")" suffixOverrides=","><if test="productId != null">product_id,</if><if test="attributeId != null">attribute_id,</if><if test="value != null">value,</if><if test="createdAt != null">created_at,</if></trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=","><if test="productId != null">#{productId},</if><if test="attributeId != null">#{attributeId},</if><if test="value != null">#{value},</if><if test="createdAt != null">#{createdAt},</if></trim>
    </insert>
    <update id="updateById" parameterType="com.itye.mall.entity.ProductAttributeValue">
        UPDATE product_attribute_values
        <set><if test="productId != null">product_id = #{productId},</if><if test="attributeId != null">attribute_id = #{attributeId},</if><if test="value != null">value = #{value},</if><if test="createdAt != null">created_at = #{createdAt},</if></set>
        WHERE id = #{id}
    </update>
    <delete id="deleteById">DELETE FROM product_attribute_values WHERE id = #{id}</delete>
</mapper>
