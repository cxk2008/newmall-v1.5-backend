<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itye.mall.mapper.CartItemMapper">
    <sql id="columns">id, cart_id, user_id, product_id, sku_id, quantity, selected, created_at, updated_at</sql>
    <select id="selectById" resultType="com.itye.mall.entity.CartItem">SELECT <include refid="columns" /> FROM cart_items WHERE id = #{id}</select>
    <select id="selectAll" resultType="com.itye.mall.entity.CartItem">SELECT <include refid="columns" /> FROM cart_items</select>
    <select id="selectByUserId" resultType="com.itye.mall.entity.CartItem">
        SELECT <include refid="columns" /> FROM cart_items WHERE user_id = #{userId} ORDER BY id DESC
    </select>
    <select id="selectSelectedByUserId" resultType="com.itye.mall.entity.CartItem">
        SELECT <include refid="columns" /> FROM cart_items WHERE user_id = #{userId} AND selected = 1 ORDER BY id DESC
    </select>
    <select id="selectByCartIdAndSkuId" resultType="com.itye.mall.entity.CartItem">
        SELECT <include refid="columns" /> FROM cart_items WHERE cart_id = #{cartId} AND sku_id = #{skuId}
    </select>
    <insert id="insert" parameterType="com.itye.mall.entity.CartItem" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cart_items
        <trim prefix="(" suffix=")" suffixOverrides=","><if test="cartId != null">cart_id,</if><if test="userId != null">user_id,</if><if test="productId != null">product_id,</if><if test="skuId != null">sku_id,</if><if test="quantity != null">quantity,</if><if test="selected != null">selected,</if><if test="createdAt != null">created_at,</if><if test="updatedAt != null">updated_at,</if></trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=","><if test="cartId != null">#{cartId},</if><if test="userId != null">#{userId},</if><if test="productId != null">#{productId},</if><if test="skuId != null">#{skuId},</if><if test="quantity != null">#{quantity},</if><if test="selected != null">#{selected},</if><if test="createdAt != null">#{createdAt},</if><if test="updatedAt != null">#{updatedAt},</if></trim>
    </insert>
    <update id="updateById" parameterType="com.itye.mall.entity.CartItem">
        UPDATE cart_items
        <set><if test="cartId != null">cart_id = #{cartId},</if><if test="userId != null">user_id = #{userId},</if><if test="productId != null">product_id = #{productId},</if><if test="skuId != null">sku_id = #{skuId},</if><if test="quantity != null">quantity = #{quantity},</if><if test="selected != null">selected = #{selected},</if><if test="createdAt != null">created_at = #{createdAt},</if><if test="updatedAt != null">updated_at = #{updatedAt},</if></set>
        WHERE id = #{id}
    </update>
    <delete id="deleteById">DELETE FROM cart_items WHERE id = #{id}</delete>
    <delete id="deleteByIdAndUserId">DELETE FROM cart_items WHERE id = #{id} AND user_id = #{userId}</delete>
    <delete id="deleteSelectedByUserId">DELETE FROM cart_items WHERE user_id = #{userId} AND selected = 1</delete>
</mapper>
