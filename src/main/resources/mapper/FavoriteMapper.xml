<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itye.mall.mapper.FavoriteMapper">
    <sql id="columns">id, user_id, product_id, created_at</sql>
    <select id="selectById" resultType="com.itye.mall.entity.Favorite">SELECT <include refid="columns" /> FROM favorites WHERE id = #{id}</select>
    <select id="selectAll" resultType="com.itye.mall.entity.Favorite">SELECT <include refid="columns" /> FROM favorites</select>
    <select id="selectByUserIdAndProductId" resultType="com.itye.mall.entity.Favorite">
        SELECT <include refid="columns" /> FROM favorites WHERE user_id = #{userId} AND product_id = #{productId} LIMIT 1
    </select>
    <select id="selectByUserIdPage" resultType="com.itye.mall.entity.Favorite">
        SELECT <include refid="columns" />
        FROM favorites
        WHERE user_id = #{userId}
        ORDER BY id DESC
        LIMIT #{offset}, #{pageSize}
    </select>
    <select id="countByUserId" resultType="long">
        SELECT COUNT(*) FROM favorites WHERE user_id = #{userId}
    </select>
    <insert id="insert" parameterType="com.itye.mall.entity.Favorite" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO favorites
        <trim prefix="(" suffix=")" suffixOverrides=","><if test="userId != null">user_id,</if><if test="productId != null">product_id,</if><if test="createdAt != null">created_at,</if></trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=","><if test="userId != null">#{userId},</if><if test="productId != null">#{productId},</if><if test="createdAt != null">#{createdAt},</if></trim>
    </insert>
    <update id="updateById" parameterType="com.itye.mall.entity.Favorite">
        UPDATE favorites
        <set><if test="userId != null">user_id = #{userId},</if><if test="productId != null">product_id = #{productId},</if><if test="createdAt != null">created_at = #{createdAt},</if></set>
        WHERE id = #{id}
    </update>
    <delete id="deleteById">DELETE FROM favorites WHERE id = #{id}</delete>
    <delete id="deleteByUserIdAndProductId">
        DELETE FROM favorites WHERE user_id = #{userId} AND product_id = #{productId}
    </delete>
</mapper>
